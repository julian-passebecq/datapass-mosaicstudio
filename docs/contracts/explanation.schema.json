{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded ConceptMotion loop resource",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "frameField": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "note": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1
    },
    "source": {
      "type": "string",
      "maxLength": 1000,
      "minLength": 1
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "loop"
        },
        "version": {
          "type": "string",
          "maxLength": 40,
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          }
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "label": {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ],
                "maxLength": 1000,
                "minimum": -1000000000000,
                "maximum": 1000000000000
              }
            },
            "required": [
              "id",
              "value"
            ]
          },
          "maxItems": 40,
          "minItems": 1
        },
        "codeLines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "text": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "id",
              "text"
            ]
          },
          "maxItems": 80,
          "minItems": 1
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "iteration": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "pointerItemId": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "activeItemIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                  "not": {
                    "enum": [
                      "constructor",
                      "prototype",
                      "__proto__"
                    ]
                  }
                },
                "maxItems": 40,
                "minItems": 0
              },
              "doneItemIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                  "not": {
                    "enum": [
                      "constructor",
                      "prototype",
                      "__proto__"
                    ]
                  }
                },
                "maxItems": 40,
                "minItems": 0
              },
              "order": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                  "not": {
                    "enum": [
                      "constructor",
                      "prototype",
                      "__proto__"
                    ]
                  }
                },
                "maxItems": 40,
                "minItems": 0
              },
              "variables": {
                "type": "object",
                "maxProperties": 20,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                  "not": {
                    "enum": [
                      "constructor",
                      "prototype",
                      "__proto__"
                    ]
                  }
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ],
                  "maxLength": 1000,
                  "minimum": -1000000000000,
                  "maximum": 1000000000000
                }
              },
              "codeLineIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                  "not": {
                    "enum": [
                      "constructor",
                      "prototype",
                      "__proto__"
                    ]
                  }
                },
                "maxItems": 80,
                "minItems": 0
              },
              "operation": {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              }
            },
            "required": [
              "id",
              "iteration",
              "codeLineIds",
              "operation",
              "caption"
            ]
          },
          "maxItems": 100,
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "version",
        "id",
        "title",
        "items",
        "codeLines",
        "frames"
      ]
    }
  },
  "required": [
    "frameField",
    "note",
    "source",
    "spec"
  ]
}
