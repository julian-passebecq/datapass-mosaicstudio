{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataPass captured task run v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "datapass.run"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "appVersion": {
      "type": "string",
      "maxLength": 80
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "modelVersion": {
      "type": "string",
      "maxLength": 80
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "parameters": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "null"
        ],
        "maxLength": 4000
      }
    },
    "dependencies": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "superseded",
        "timed-out",
        "unobserved"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "artifact": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "const": "datapass.artifact"
            },
            "version": {
              "const": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
              "not": {
                "enum": [
                  "constructor",
                  "prototype",
                  "__proto__"
                ]
              }
            },
            "title": {
              "type": "string",
              "maxLength": 160
            },
            "provenance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "synthetic",
                    "provided",
                    "computed"
                  ]
                },
                "source": {
                  "type": "string",
                  "maxLength": 2000
                },
                "runId": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                  "not": {
                    "enum": [
                      "constructor",
                      "prototype",
                      "__proto__"
                    ]
                  }
                }
              },
              "required": [
                "kind",
                "source"
              ]
            },
            "payload": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "table"
                    },
                    "rowKey": {
                      "type": "string",
                      "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                      "not": {
                        "enum": [
                          "constructor",
                          "prototype",
                          "__proto__"
                        ]
                      }
                    },
                    "columns": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                            "not": {
                              "enum": [
                                "constructor",
                                "prototype",
                                "__proto__"
                              ]
                            }
                          },
                          "label": {
                            "type": "string",
                            "maxLength": 120
                          },
                          "type": {
                            "enum": [
                              "string",
                              "number",
                              "boolean"
                            ]
                          },
                          "unit": {
                            "type": "string",
                            "maxLength": 40
                          },
                          "nullable": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "type"
                        ]
                      },
                      "maxItems": 40,
                      "minItems": 1
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "maxProperties": 40,
                        "propertyNames": {
                          "type": "string",
                          "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                          "not": {
                            "enum": [
                              "constructor",
                              "prototype",
                              "__proto__"
                            ]
                          }
                        },
                        "additionalProperties": {
                          "type": [
                            "number",
                            "string",
                            "boolean",
                            "null"
                          ],
                          "maxLength": 4000
                        }
                      },
                      "maxItems": 10000,
                      "minItems": 0
                    }
                  },
                  "required": [
                    "kind",
                    "rowKey",
                    "columns",
                    "rows"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 20000
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ]
                }
              ]
            },
            "representations": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                        "not": {
                          "enum": [
                            "constructor",
                            "prototype",
                            "__proto__"
                          ]
                        }
                      },
                      "title": {
                        "type": "string",
                        "maxLength": 160
                      },
                      "kind": {
                        "const": "table"
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "kind"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                        "not": {
                          "enum": [
                            "constructor",
                            "prototype",
                            "__proto__"
                          ]
                        }
                      },
                      "title": {
                        "type": "string",
                        "maxLength": 160
                      },
                      "kind": {
                        "const": "text"
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "kind"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                        "not": {
                          "enum": [
                            "constructor",
                            "prototype",
                            "__proto__"
                          ]
                        }
                      },
                      "title": {
                        "type": "string",
                        "maxLength": 160
                      },
                      "kind": {
                        "const": "json"
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "kind"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                        "not": {
                          "enum": [
                            "constructor",
                            "prototype",
                            "__proto__"
                          ]
                        }
                      },
                      "title": {
                        "type": "string",
                        "maxLength": 160
                      },
                      "kind": {
                        "const": "chart"
                      },
                      "chart": {
                        "enum": [
                          "bar",
                          "line",
                          "scatter"
                        ]
                      },
                      "x": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                        "not": {
                          "enum": [
                            "constructor",
                            "prototype",
                            "__proto__"
                          ]
                        }
                      },
                      "y": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                        "not": {
                          "enum": [
                            "constructor",
                            "prototype",
                            "__proto__"
                          ]
                        }
                      },
                      "unit": {
                        "type": "string",
                        "maxLength": 30
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "kind",
                      "chart",
                      "x",
                      "y"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                        "not": {
                          "enum": [
                            "constructor",
                            "prototype",
                            "__proto__"
                          ]
                        }
                      },
                      "title": {
                        "type": "string",
                        "maxLength": 160
                      },
                      "kind": {
                        "const": "metric"
                      },
                      "row": {
                        "type": "string",
                        "maxLength": 160
                      },
                      "column": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                        "not": {
                          "enum": [
                            "constructor",
                            "prototype",
                            "__proto__"
                          ]
                        }
                      },
                      "unit": {
                        "type": "string",
                        "maxLength": 40
                      },
                      "digits": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 6
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "kind",
                      "row",
                      "column"
                    ]
                  }
                ]
              },
              "maxItems": 12,
              "minItems": 1
            }
          },
          "required": [
            "format",
            "version",
            "id",
            "title",
            "provenance",
            "payload",
            "representations"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "retention": {
      "enum": [
        "pending",
        "retained",
        "none",
        "omitted-budget",
        "invalid-output"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "taskId",
    "appId",
    "appVersion",
    "modelId",
    "modelVersion",
    "providerId",
    "parameters",
    "dependencies",
    "status",
    "startedAt",
    "finishedAt",
    "durationMs",
    "artifact",
    "retention",
    "message"
  ]
}
