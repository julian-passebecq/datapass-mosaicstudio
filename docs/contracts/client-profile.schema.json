{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataPass client family profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "datapass.client-profile"
    },
    "version": {
      "const": 1
    },
    "family": {
      "enum": [
        "content",
        "knowledge",
        "analytics",
        "spatial",
        "replay"
      ]
    }
  },
  "required": [
    "format",
    "version",
    "family"
  ]
}
