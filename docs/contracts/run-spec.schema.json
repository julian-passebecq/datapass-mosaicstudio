      "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
