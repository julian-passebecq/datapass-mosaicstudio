{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataPass semantic navigation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "datapass.navigation"
    },
    "version": {
      "const": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
            "not": {
              "enum": [
                "constructor",
                "prototype",
                "__proto__"
              ]
            }
          },
          "label": {
            "type": "string",
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "maxLength": 40
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          },
          "external": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "summary",
          "external"
        ]
      },
      "maxItems": 99,
      "minItems": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
            "not": {
              "enum": [
                "constructor",
                "prototype",
                "__proto__"
              ]
            }
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
            "not": {
              "enum": [
                "constructor",
                "prototype",
                "__proto__"
              ]
            }
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
            "not": {
              "enum": [
                "constructor",
                "prototype",
                "__proto__"
              ]
            }
          },
          "kind": {
            "enum": [
              "depends-on",
              "contains",
              "integrates-with",
              "related"
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "source"
        ]
      },
      "maxItems": 300,
      "minItems": 0
    },
    "facets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
            "not": {
              "enum": [
                "constructor",
                "prototype",
                "__proto__"
              ]
            }
          },
          "label": {
            "type": "string",
            "maxLength": 100
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
              "not": {
                "enum": [
                  "constructor",
                  "prototype",
                  "__proto__"
                ]
              }
            },
            "maxItems": 99,
            "minItems": 0
          }
        },
        "required": [
          "id",
          "label",
          "entities"
        ]
      },
      "maxItems": 12,
      "minItems": 1
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
            "not": {
              "enum": [
                "constructor",
                "prototype",
                "__proto__"
              ]
            }
          },
          "label": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "maxItems": 8,
      "minItems": 1
    },
    "depths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
            "not": {
              "enum": [
                "constructor",
                "prototype",
                "__proto__"
              ]
            }
          },
          "label": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "maxItems": 4,
      "minItems": 1
    }
  },
  "required": [
    "format",
    "version",
    "entities",
    "relations",
    "facets",
    "projections",
    "depths"
  ]
}
