{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inert client source excerpt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "path": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1
    },
    "language": {
      "enum": [
        "python",
        "sql",
        "typescript",
        "json",
        "markdown",
        "text"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 160,
      "minLength": 1
    },
    "text": {
      "type": "string",
      "maxLength": 64000
    },
    "provenance": {
      "enum": [
        "synthetic",
        "provided"
      ]
    }
  },
  "required": [
    "id",
    "path",
    "language",
    "title",
    "text",
    "provenance"
  ]
}
