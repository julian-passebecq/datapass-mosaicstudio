{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataPass approved context payload v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "datapass.context"
    },
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
            "not": {
              "enum": [
                "constructor",
                "prototype",
                "__proto__"
              ]
            }
          },
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "mode": {
            "enum": [
              "full",
              "summary",
              "excerpt"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 256000
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "artifact": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
                  "not": {
                    "enum": [
                      "constructor",
                      "prototype",
                      "__proto__"
                    ]
                  }
                },
                "start": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "label": {
                  "type": "string",
                  "maxLength": 160
                }
              },
              "required": [
                "artifact",
                "start",
                "end",
                "label"
              ]
            },
            "maxItems": 8,
            "minItems": 0
          }
        },
        "required": [
          "sourceId",
          "path",
          "mode",
          "text",
          "references"
        ]
      },
      "maxItems": 24,
      "minItems": 0
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,79}$",
            "not": {
              "enum": [
                "constructor",
                "prototype",
                "__proto__"
              ]
            }
          },
          "reason": {
            "enum": [
              "excluded",
              "budget"
            ]
          }
        },
        "required": [
          "sourceId",
          "reason"
        ]
      },
      "maxItems": 24,
      "minItems": 0
    }
  },
  "required": [
    "format",
    "version",
    "entries",
    "omitted"
  ]
}
