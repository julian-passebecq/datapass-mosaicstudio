{
  "name": "datapass-mosaicstudio",
  "version": "0.7.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "npm run bootstrap && node --experimental-strip-types scripts/prepare-assets.mjs",
    "bootstrap": "node scripts/bootstrap-upstreams.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run bootstrap && node --experimental-strip-types scripts/prepare-assets.mjs && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "test:fixtures": "python scripts/make-test-fixtures.py",
    "contracts": "node --experimental-strip-types scripts/export-contracts.mjs",
    "contracts:check": "node --experimental-strip-types scripts/export-contracts.mjs --check",
    "client:capture": "node --experimental-strip-types scripts/capture-client.mjs",
    "client:dev": "node --experimental-strip-types scripts/client-dev.mjs",
    "client:new": "node --experimental-strip-types scripts/scaffold-client.mjs",
    "client:check": "node --experimental-strip-types scripts/check-clients.mjs",
    "test:visual-contracts": "node scripts/check-visuals.mjs",
    "build:client": "node --experimental-strip-types scripts/build-client.mjs",
    "test:client-builds": "node --experimental-strip-types scripts/test-client-builds.mjs && node scripts/check-client-performance.mjs",
    "test:client-performance": "node scripts/check-client-performance.mjs",
    "client:context": "node --experimental-strip-types scripts/client-context.mjs",
    "client:families": "node --experimental-strip-types scripts/client-context.mjs --families",
    "model:inspect": "node --experimental-strip-types scripts/inspect-model.mjs",
    "test:python": "python -m unittest discover -s py -p \"test_*.py\"",
    "test:python-bridge": "node scripts/smoke-python-bridge.mjs",
    "service:python": "python py/service/app.py",
    "test:python-service": "node scripts/smoke-python-service.mjs",
    "test:artifact-watch": "node scripts/smoke-artifact-watch.mjs",
    "test:artifact-lineage": "node scripts/smoke-artifact-lineage.mjs",
    "test:engine":"node --experimental-strip-types scripts/test-engine-consolidation.mjs"
  },
  "overrides": {
    "@duckdb/duckdb-wasm": "1.32.0"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@sqlrooms/duckdb": "0.29.0-rc.7",
    "@sqlrooms/mosaic": "0.29.0-rc.7",
    "@sqlrooms/room-shell": "0.29.0-rc.7",
    "@sqlrooms/sql-editor": "0.29.0-rc.7",
    "@sqlrooms/ui": "0.29.0-rc.7",
    "@fluentui/react-components": "9.74.5",
    "@xyflow/react": "12.8.5",
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "lucide-react": "0.555.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.24.2",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.1.18",
    "@types/d3": "7.4.3",
    "@types/d3-sankey": "0.12.4",
    "@types/node": "22.13.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.0.3",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "esbuild": "0.25.12",
    "@types/three": "0.180.0"
  }
}
