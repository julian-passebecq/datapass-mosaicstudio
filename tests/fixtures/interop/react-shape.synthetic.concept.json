      "evidence": [{"kind": "source", "ref": "web/src/api/client.ts:11", "label": "fetch /books"}, {"kind": "source", "ref": "web/src/api/client.ts:19", "label": "fetch /orders"}]},
    {"id": "users-bookshop-web", "kind": "users", "layer": "users", "domain": "d-bookshop-web", "label": "Shoppers",
      "description": "People who use the bookshop-web screens (synthetic)."}
  ],
  "flows": [
    {"id": "f-users-screens", "from": "users-bookshop-web", "to": "screens-bookshop-web-screens", "kind": "control", "label": "use"},
    {"id": "f-screens-calls", "from": "screens-bookshop-web-screens", "to": "screens-bookshop-web-calls", "kind": "control", "label": "calls · 3 traces",
      "evidence": [{"kind": "source", "ref": "web/src/pages/SearchPage.tsx:40", "label": "SearchPage → fetch /books"}]},
    {"id": "f-calls-routes", "from": "screens-bookshop-web-calls", "to": "server-bookshop-api-routes", "kind": "data", "label": "HTTP · 2 traces", "direction": "both",
      "evidence": [{"kind": "source", "ref": "web/src/api/client.ts:11", "label": "fetch /books → GET /books"}, {"kind": "source", "ref": "web/src/api/client.ts:19", "label": "fetch /orders → POST /orders"}]},
    {"id": "f-routes-code", "from": "server-bookshop-api-routes", "to": "server-bookshop-api-code", "kind": "control", "label": "calls · 1 trace",
      "evidence": [{"kind": "source", "ref": "api/src/routes/orders.ts:12", "label": "POST /orders → priceOrder"}]},
    {"id": "f-code-tables", "from": "server-bookshop-api-code", "to": "data-bookshop-api-tables", "kind": "data", "label": "reads and writes · 2 traces", "direction": "both",
      "evidence": [{"kind": "source", "ref": "api/src/services/stock.ts:15", "label": "reserveStock → order_lines"}]},
    {"id": "f-queries-screens", "from": "data-bookshop-web-queries", "to": "screens-bookshop-web-screens", "kind": "data", "label": "reads · inferred (1 trace)",
      "evidence": [{"kind": "source", "ref": "web/src/pages/SearchPage.tsx:12", "label": "inferred: SearchPage → SEARCH_SQL"}]},
    {"id": "f-calls-unresolved", "from": "screens-bookshop-web-calls", "to": "server-unresolved", "kind": "data", "label": "unresolved link",
      "evidence": [{"kind": "source", "ref": "web/src/home/Recommendations.tsx:15", "label": "unresolved: fetch template URL"}]},
    {"id": "f-routes-unresolved", "from": "server-bookshop-api-routes", "to": "server-unresolved", "kind": "control", "label": "unresolved import",
      "evidence": [{"kind": "source", "ref": "api/src/routes/orders.ts:3", "label": "unresolved: ./legacy/payments"}]}
  ],
  "annotations": [
    {"id": "unresolved-links", "target": "server-unresolved", "text": "2 links could not be resolved; they are drawn to the Unresolved node instead of being dropped."},
    {"id": "synthetic-note", "text": "SYNTHETIC fixture: shape mirrors a React export, content is invented."}
