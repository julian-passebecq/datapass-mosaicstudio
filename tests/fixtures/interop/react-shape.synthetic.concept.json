{
  "$schema": "https://raw.githubusercontent.com/julian-passebecq/datapass-mosaicstudio/main/spec/concept/v1/concept-spec.schema.json",
  "format": "datapass.concept-spec",
  "version": 1,
  "specVersion": "1.0.0",
  "id": "bookshop-synthetic",
  "title": "Bookshop monorepo (SYNTHETIC, React-exporter shape)",
  "subtitle": "Independently authored test fixture that mirrors the shape of a DataPass React 2.1 export: four layers, one domain per package, merged code items, inferred trace flows and an Unresolved side domain.",
  "provenance": "synthetic",
  "note": "SYNTHETIC. Written by hand for MosaicStudio interoperability tests (FR-04). It describes no real repository; every path and line number is invented. Real exports stay in private local evidence.",
  "layers": [
    {"id": "data", "label": "Data", "height": 0, "role": "storage", "description": "Tables, schemas and queries found in the code."},
    {"id": "server", "label": "Server", "height": 1, "role": "compute", "description": "API routes and server code."},
    {"id": "screens", "label": "Screens", "height": 2, "role": "experience", "description": "Pages, components and browser calls."},
    {"id": "users", "label": "Users", "height": 3, "role": "users", "description": "People who use the screens."}
  ],
  "domains": [
    {"id": "d-bookshop-web", "label": "bookshop-web", "description": "Package bookshop-web (synthetic).", "placement": "main"},
    {"id": "d-bookshop-api", "label": "bookshop-api", "description": "Package bookshop-api (synthetic).", "placement": "main"},
    {"id": "d-unresolved", "label": "Unresolved", "description": "Links the analysis could not resolve. They are kept, not dropped.", "placement": "side"}
  ],
  "nodes": [
