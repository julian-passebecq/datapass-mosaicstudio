      "evidence": [{"kind": "source", "ref": "api/src/routes/books.ts:10", "label": "GET /books"}, {"kind": "source", "ref": "api/src/routes/books.ts:22", "label": "GET /books/:id"}, {"kind": "source", "ref": "api/src/routes/orders.ts:9", "label": "POST /orders"}, {"kind": "source", "ref": "api/src/routes/orders.ts:31", "label": "GET /orders/:id"}]},
    {"id": "server-bookshop-api-code", "kind": "function", "layer": "server", "domain": "d-bookshop-api", "label": "Server code (2)",
      "description": "Server code: 2 items merged into one node: priceOrder, reserveStock.",
      "sources": [{"path": "api/src/services/pricing.ts"}],
      "evidence": [{"kind": "source", "ref": "api/src/services/pricing.ts:4", "label": "priceOrder"}, {"kind": "source", "ref": "api/src/services/stock.ts:7", "label": "reserveStock"}]},
    {"id": "server-unresolved", "kind": "external", "layer": "server", "domain": "d-unresolved", "label": "Unresolved (2)", "status": "external",
