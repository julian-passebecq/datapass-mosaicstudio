    {"id": "data-bookshop-web-queries", "kind": "database", "layer": "data", "domain": "d-bookshop-web", "label": "Queries and schemas (2)",
      "description": "Queries and schemas: 2 items merged into one node: SEARCH_SQL, SELECT query (line 30).",
      "sources": [{"path": "web/src/search/queries.ts"}],
      "evidence": [{"kind": "source", "ref": "web/src/search/queries.ts:8", "label": "SEARCH_SQL"}, {"kind": "source", "ref": "web/src/search/queries.ts:30", "label": "SELECT query (line 30)"}]},
    {"id": "server-bookshop-api-routes", "kind": "api", "layer": "server", "domain": "d-bookshop-api", "label": "API routes (4)",
