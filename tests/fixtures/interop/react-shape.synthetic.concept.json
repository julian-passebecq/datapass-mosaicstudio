    {"id": "screens-bookshop-web-screens", "kind": "web-app", "layer": "screens", "domain": "d-bookshop-web", "label": "Screens (3)",
      "description": "Screens: 3 items merged into one node: HomePage, SearchPage, CheckoutPage.",
      "sources": [{"path": "web/src/pages/HomePage.tsx"}, {"path": "web/src/pages/SearchPage.tsx"}, {"path": "web/src/pages/CheckoutPage.tsx"}],
      "evidence": [{"kind": "source", "ref": "web/src/pages/HomePage.tsx:1", "label": "HomePage"}, {"kind": "source", "ref": "web/src/pages/SearchPage.tsx:1", "label": "SearchPage"}, {"kind": "source", "ref": "web/src/pages/CheckoutPage.tsx:1", "label": "CheckoutPage"}]},
